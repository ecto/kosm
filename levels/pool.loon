; the pool — a Kosm scene.
;
; Authorship lives here; pool.rs supplies this scene's fluid, rigid-body, and
; light computations. vcad lengths are millimetres and simulation lengths are
; converted to metres exactly once by AuthoredScene.

; ---- environment ------------------------------------------------------------
[defparam pool_length_mm 50000.0]
[defparam pool_width_mm 25000.0]
[defparam pool_depth_mm 2000.0]

; ---- watermelon -------------------------------------------------------------
[defparam drop_height_mm 1300.0]
[defparam melon_a_mm 150.0]
[defparam melon_b_mm 105.0]
[defparam melon_c_mm 105.0]
[defparam melon_density 950.0]

; ---- water computation ------------------------------------------------------
[defparam water_cell_mm 25.0]
[defparam water_bulk_modulus 2.0e6]
[defparam water_air_above_mm 1000.0]
[defparam water_settle_seconds 2.0]
[defparam water_use_gpu 1.0]
[defparam fps 60.0]

; vcad's cube has a corner at the origin. These roots make the authored scene
; inspectable today. The coarse simulation and renderers consume these authored
; dimensions; the fine-water solver still requires the reference basin.
[let pool-volume
  [translate [/ pool_length_mm -2.0] [/ pool_width_mm -2.0] [* pool_depth_mm -1.0]
    [cube pool_length_mm pool_width_mm pool_depth_mm]]]

[let melon-bounds
  [translate [* melon_a_mm -1.0] [* melon_b_mm -1.0] [- drop_height_mm melon_c_mm]
    [cube [* melon_a_mm 2.0] [* melon_b_mm 2.0] [* melon_c_mm 2.0]]]]

[root pool-volume "water"]
[root melon-bounds "watermelon"]
