; the skatepark — a Kosm scene, and a training level for the K1 in ../ipse.
;
; A mini ramp: a flat bottom with a quarterpipe at each end, a deck behind
; each lip and a coping rod on the edge. Z-up, mm, vcad's conventions (cube
; corner at the origin, cylinder base at z = 0 along z, booleans subject-last:
; `[difference tool subject]` is subject − tool). The flat's top is z = 0 and
; x = 0 is the middle of the flat. skatepark.rs reads this and nothing else.
;
; Sized for a Booster K1 (1.2 m tall), not a person: a 600 mm lip on a
; 1200 mm radius is a 60° transition, well under vert. Everything is one
; solid so the baked signed distance has one inside.

; ---- the ramp ---------------------------------------------------------------
[defparam tr_r_mm 1200.0]       ; transition radius
[defparam lip_mm 600.0]         ; lip height above the flat (< tr_r_mm: under vert)
[defparam width_mm 2400.0]      ; ramp width, along y
[defparam flat_mm 3000.0]       ; flat bottom, along x
[defparam deck_mm 600.0]        ; platform behind each lip
[defparam coping_r_mm 30.0]     ; coping rod radius
[defparam slab_t_mm 40.0]       ; slab under everything, top at z = 0
[defparam second_side 1.0]      ; 0 leaves a single quarterpipe at +x

; ---- the bake ---------------------------------------------------------------
[defparam sdf_cell_mm 10.0]     ; the wheels are 27 mm; 20 mm would flatten the coping
[defparam sdf_pad_mm 300.0]     ; volume beyond the geometry; past it there is no floor

; ---- the check --------------------------------------------------------------
; a solid sphere the size of a skateboard wheel, set on the +x transition
; with its contact point drop_mm above the flat, released, rolled on the
; baked map through the same SDF contact path the K1's feet use.
[defparam wheel_r_mm 27.0]
[defparam wheel_g 60.0]
[defparam drop_mm 450.0]
[defparam friction 0.8]
[defparam t_end 4.0]
[defparam dt_ms 1.0]

; ---- the ipse scenario ------------------------------------------------------
[defparam shove_at 1.0]         ; s
[defparam shove_ns 8.0]         ; N·s, sagittal, toward the +x transition

; centred box: vcad's cube has a corner at the origin.
[let box-c [fn [x y z] [translate [/ x -2.0] [/ y -2.0] [/ z -2.0] [cube x y z]]]]

; a cylinder along y, centred on the origin, radius r, length l
[let rod-y [fn [r l] [translate 0.0 [/ l 2.0] 0.0 [rotate 90.0 0.0 0.0 [cylinder r l]]]]]

[let half-flat [/ flat_mm 2.0]]
; the lip sits tr_r·sin(θ) past the end of the flat, where cos(θ) = 1 − lip/tr_r
[let lip-cos [- 1.0 [/ lip_mm tr_r_mm]]]
[let lip-sin [sqrt [- 1.0 [* lip-cos lip-cos]]]]
[let tr-x [* tr_r_mm lip-sin]]
[let cut-l [* 1.2 width_mm]]

; one quarterpipe on side s (±1): a block from the end of the flat to the lip,
; minus the cylinder whose axis runs along y one radius above the flat's end.
[let transition [fn [s]
  [difference
    [translate [* s half-flat] 0.0 tr_r_mm [rod-y tr_r_mm cut-l]]
    [translate [* s [+ half-flat [/ tr-x 2.0]]] 0.0 [/ lip_mm 2.0]
      [box-c tr-x width_mm lip_mm]]]]]

[let deck [fn [s]
  [translate [* s [+ half-flat tr-x [/ deck_mm 2.0]]] 0.0 [/ lip_mm 2.0]
    [box-c deck_mm width_mm lip_mm]]]]

[let coping [fn [s]
  [translate [* s [+ half-flat tr-x]] 0.0 lip_mm [rod-y coping_r_mm width_mm]]]]

[let span [* 2.0 [+ half-flat tr-x deck_mm]]]
[let slab [translate 0.0 0.0 [/ slab_t_mm -2.0] [box-c span width_mm slab_t_mm]]]

[let side [fn [s] [union [union [transition s] [deck s]] [coping s]]]]

[let park [if [> second_side 0.5]
  [union [union slab [side 1.0]] [side -1.0]]
  [union slab [side 1.0]]]]

[root park "concrete"]
