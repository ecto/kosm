; the cove — a Kosm scene, and the first Rune level.
;
; A beach in a cove: sand rising out of the sea to a cliff, a stone door set
; into the cliff, and a small round aperture in the door that reads the caustic
; a being of glass throws through itself. Z-up, mm, vcad's conventions (cube
; corner at the origin, cylinder base at z = 0 along z, booleans subject-last:
; `[difference tool subject]` is subject − tool).
;
; The level is a cove_mm square centred on x = 0. The sea is along −y: the
; waterline is y = −cove_mm/2 at z = sea_z_mm, and the sand rises toward +y at
; beach_slope, so it is 0.06 · 40 m = 2.4 m up by the time it reaches the
; cliff. The sea itself is not geometry — it is a rendered height field at
; sea_z_mm — and neither is the aperture: the door's face is solid stone, and
; the keyhole is the disc on it the score is read over. cove.rs reads this file
; and nothing else.

; ---- the cove ---------------------------------------------------------------
[defparam cove_mm 40000.0]      ; the level is a cove_mm square, sea along −y
[defparam beach_slope 0.06]     ; the sand rises from the waterline at this grade
[defparam sea_z_mm 0.0]         ; the waterline, at y = −cove_mm/2
[defparam cliff_h_mm 6000.0]    ; the back wall of the cove, above the sand at its foot
[defparam cliff_t_mm 4000.0]    ; how deep the cliff is along y; its −y face carries the door

; ---- the door ---------------------------------------------------------------
; A slab of stone standing on the sand in a recess in the cliff face, its face
; toward −y. Its own root, because it is the one part of the level that moves.
[defparam door_w_mm 1800.0]
[defparam door_h_mm 2600.0]
[defparam door_t_mm 200.0]
[defparam door_x_mm 0.0]        ; where along the cliff the door sits
[defparam aperture_r_mm 120.0]  ; the rune's keyhole: a disc on the door face, not geometry
[defparam aperture_z_mm 1500.0] ; keyhole height above the sand at the door
[defparam open_frac 0.3]        ; the score that opens the door

; ---- the sun ----------------------------------------------------------------
; A low afternoon sun out over the sea, so what it throws through the being
; lands on the cliff face.
[defparam sun_az_deg 200.0]     ; toward the sun, about z, from +x toward +y
[defparam sun_el_deg 22.0]      ; above the horizon

; ---- the being --------------------------------------------------------------
; A capsule of glass on one free joint: the marble grown up, and the lens.
[defparam being_r_mm 350.0]
[defparam being_h_mm 1400.0]
[defparam n_d 1.5168]           ; the d-line index of N-BK7
[defparam walk_mps 1.4]         ; the speed the walking force is capped at
[defparam spawn_x_mm -9000.0]   ; where you start
[defparam spawn_y_mm -6000.0]

; ---- the solution -----------------------------------------------------------
; Solved, not authored: the pose whose caustic falls in the aperture. The
; search writes these back into this file, the way the marble writes its
; solved knobs. Zeros mean "not solved yet".
[defparam solution_x_mm 0.0]
[defparam solution_y_mm 0.0]
[defparam solution_tilt_deg 0.0]

; ---- the bake ---------------------------------------------------------------
[defparam sdf_cell_mm 100.0]    ; the being's feet are 350 mm across
[defparam sdf_pad_mm 300.0]     ; volume beyond the cove; past it there is no floor

; centred box: vcad's cube has a corner at the origin.
[let box-c [fn [x y z] [translate [/ x -2.0] [/ y -2.0] [/ z -2.0] [cube x y z]]]]

[let half-cove [/ cove_mm 2.0]]
[let deg-per-rad [/ 180.0 3.14159265358979]]
; the beach's tilt about x: [rotate a 0 0 s] sends +z to (0, −sin a, cos a), so
; a positive angle lifts the +y end, which is the way the sand runs.
[let beach-deg [* [atan beach_slope] deg-per-rad]]
; the top of the sand at y, which is the plane the being walks on
[let sand-z [fn [y] [+ sea_z_mm [* beach_slope [+ y half-cove]]]]]

; ---- the beach --------------------------------------------------------------
; A slab modelled flat with its top face through the origin, tilted about x,
; then lifted so the sand meets the sea at the waterline. Tilting shortens its
; y footprint by cos a, so it is authored 1/cos a long and ends up exactly the
; cove square.
[defparam beach_t_mm 2000.0]
[let beach-l [* cove_mm [sqrt [+ 1.0 [* beach_slope beach_slope]]]]]
[let beach
  [translate 0.0 0.0 [sand-z 0.0]
    [rotate beach-deg 0.0 0.0
      [translate 0.0 0.0 [/ beach_t_mm -2.0] [box-c cove_mm beach-l beach_t_mm]]]]]

; ---- the cliff --------------------------------------------------------------
; The +y edge of the cove, from below the sand to cliff_h_mm above the sand at
; its foot, with the door's recess cut out of its face.
[let cliff-face-y [- half-cove cliff_t_mm]]      ; the face the door is set into
[let door-sill [sand-z cliff-face-y]]            ; the sand at the door
[let cliff-lo [- sea_z_mm 4000.0]]
[let cliff-hi [+ [sand-z half-cove] cliff_h_mm]]
[let recess
  [translate door_x_mm [+ cliff-face-y [/ door_t_mm 2.0]] [+ door-sill [/ door_h_mm 2.0]]
    [box-c door_w_mm [+ door_t_mm 20.0] door_h_mm]]]
[let cliff
  [difference recess
    [translate 0.0 [/ [+ cliff-face-y half-cove] 2.0] [/ [+ cliff-lo cliff-hi] 2.0]
      [box-c cove_mm cliff_t_mm [- cliff-hi cliff-lo]]]]]

; ---- the rocks --------------------------------------------------------------
; Boulders half buried in the sand and one sea stack, unioned into the same
; solid so the bake has one inside. They are away from the line the marble
; test rolls down, which is the beach and nothing else.
[let rock [fn [x y r] [translate x y [- [sand-z y] [* 0.35 r]] [sphere r]]]]
[let stack
  [translate -13000.0 6000.0 [- [sand-z 6000.0] 400.0] [cylinder 700.0 2600.0]]]
[let rocks
  [union [union [union [rock 5000.0 -3000.0 900.0] [rock -3000.0 2000.0 600.0]]
                [rock 11000.0 -11000.0 1500.0]]
         stack]]

; ---- the ground -------------------------------------------------------------
; One solid, so the baked signed distance has one inside.
[let ground [union [union beach cliff] rocks]]

; ---- the door ---------------------------------------------------------------
[let door
  [translate door_x_mm [+ cliff-face-y [/ door_t_mm 2.0]] [+ door-sill [/ door_h_mm 2.0]]
    [box-c door_w_mm door_t_mm door_h_mm]]]

[root ground "sand"]
[root door "stone"]
