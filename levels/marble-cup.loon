; the marble, with a cup that is a real hollow — a Kosm level.
;
; `marble.loon` builds its cup out of a ring of box segments, because a ring of
; boxes is a union of convex primitives and convex primitives are what phyz
; colliders are. This file builds the same cup the way a person would actually
; model it: a solid cylinder with a bore taken out of it and a slot cut in the
; uphill side. That is two `difference`s, and a difference has no convex
; collider — so `colliders.rs` decomposes it into a ring of convex wedges and
; checks that none of them reaches into what was cut away.
;
; Everything else is `marble.loon` unchanged. Geometry is vcad (Z-up, mm,
; degrees, cube corner at origin, cylinder base at z=0). Booleans are
; subject-last: `[difference tool subject]` is `subject − tool`.

; ---- knobs ------------------------------------------------------------------
[defparam pitch_deg 5.0]      ; tilt about y; positive lowers the +x end
[defparam roll_deg 0.0]       ; tilt about x; positive lowers the -y end
[defparam start_x -100.0]     ; marble release point, plate frame (mm)
[defparam start_y 25.0]
[defparam marble_r 10.0]      ; a glass marble
[defparam marble_g 12.0]      ; grams
[defparam t_end 1.2]          ; seconds until the marble should be in the cup

; ---- the lamp ---------------------------------------------------------------
; a point lamp in the room (world frame, mm, relative to the table's origin)
; and where the marble's shadow should land at t_end (plate frame, mm).
[defparam lamp_x 60.0]
[defparam lamp_y -250.0]
[defparam lamp_z 250.0]      ; low enough that the shadow has a lever (a 1 cm marble under
                              ; a 55 cm lamp casts a shadow that never leaves it), high
                              ; enough that the near wall's shadow stops at the plate edge
[defparam lamp_r 25.0]        ; lamp radius: sets the penumbra, and so the shadow's gradient
[defparam shadow_x 149.0]     ; x is set by the end wall at t_end; y is the knob
[defparam shadow_y -20.0]

; ---- the track --------------------------------------------------------------
[defparam plate_x 300.0]
[defparam plate_y 200.0]
[defparam plate_t 10.0]
[defparam wall_h 30.0]
[defparam wall_t 8.0]
[defparam cup_x 90.0]         ; cup centre, plate frame; +x is downhill
[defparam cup_r 22.0]         ; inside radius
[defparam cup_wall 3.0]
[defparam cup_h 14.0]

; centred box: vcad's cube has a corner at the origin.
[let box-c [fn [x y z] [translate [/ x -2.0] [/ y -2.0] [/ z -2.0] [cube x y z]]]]

; plate top is z = 0
[let plate [translate 0.0 0.0 [/ plate_t -2.0] [box-c plate_x plate_y plate_t]]]

[let side-wall [fn [sign]
  [translate 0.0 [* sign [/ [+ plate_y wall_t] 2.0]] [/ wall_h 2.0]
    [box-c [+ plate_x [* 2.0 wall_t]] wall_t wall_h]]]]
[let end-wall [fn [sign]
  [translate [* sign [/ [+ plate_x wall_t] 2.0]] 0.0 [/ wall_h 2.0]
    [box-c wall_t plate_y wall_h]]]]

; the cup, as a subtraction. Outer radius cup_r + cup_wall, bored to cup_r; the
; bore is 10% taller than the wall so it goes right through and leaves no floor
; (the plate is the floor).
[let cup_R [+ cup_r cup_wall]]
[let cup-tube [difference
  [translate cup_x 0.0 0.0 [cylinder cup_r [* 1.1 cup_h]]]
  [translate cup_x 0.0 0.0 [cylinder cup_R cup_h]]]]

; the mouth: a box cut off the -x (uphill) side, leaving the same 112.5° gap the
; segment ring in marble.loon leaves. The chord at ±56.25° sits at
; x = -cos(56.25°)·R = -0.5556 R and reaches y = ±sin(56.25°)·R = ±0.8315 R.
[let cup [difference
  [translate [+ cup_x [* -1.2778 cup_R]] 0.0 [/ cup_h 2.0]
    [box-c [* 1.4444 cup_R] [* 1.6630 cup_R] [* 1.2 cup_h]]]
  cup-tube]]

[let track [pipe plate
  [union [side-wall 1.0]]
  [union [side-wall -1.0]]
  [union [end-wall 1.0]]
  [union [end-wall -1.0]]
  [union cup]]]

[root track "pla"]
