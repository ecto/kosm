; Earth-orbit spacecraft. SI dynamics parameters; CAD geometry in millimetres.
[defparam earth_radius_m 6378137.0]
[defparam earth_mu 3.986004415e14]
[defparam earth_j2 0.001082626335439]
[defparam altitude_m 420000.0]
[defparam inclination_deg 51.6]
[defparam phase_deg -18.0]
[defparam mass_kg 2400.0]
[defparam bus_x_mm 2800.0]
[defparam bus_y_mm 2200.0]
[defparam bus_z_mm 2600.0]
[defparam panel_span_mm 18000.0]
[defparam panel_chord_mm 4000.0]
[defparam panel_thickness_mm 60.0]
[defparam spin_x_deg_s 0.04]
[defparam spin_y_deg_s 0.13]
[defparam spin_z_deg_s 0.02]
[let bus [translate [/ bus_x_mm -2] [/ bus_y_mm -2] [/ bus_z_mm -2] [cube bus_x_mm bus_y_mm bus_z_mm]]]
[let wing [translate [/ panel_chord_mm -2] [/ panel_span_mm -2] -30 [cube panel_chord_mm panel_span_mm panel_thickness_mm]]]
[root bus "spacecraft bus"]
[root wing "solar array envelope"]
