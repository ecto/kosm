; the warehouse — THPS1's first level, scaled to the K1, in a shed.
;
; Same conventions as levels/skatepark.loon: Z-up, mm, vcad's cube has a
; corner at the origin, its cylinder a base at z = 0 along z, booleans are
; subject-last (`[difference tool subject]` is subject − tool), and `union`
; is binary, so a pile of parts is a nest of unions.
;
; One root per piece, each with a material name. Roots whose material is
; "no-collide" (roof, trusses, skylight, clerestory, door frame, lamps, the
; walls above the skirt) are drawn but never baked; everything else is the
; collision set, and skatepark.rs bakes exactly that into mesh.stl and the
; SDF.
;
; Two rules the bake imposes on the collision set, both from the same fact —
; the field's sign comes from the *nearest* triangle's pseudonormal:
;
;   * within a root, overlapping solids must be unioned (CSG merges them into
;     one shell), or left disjoint;
;   * between roots, no two shells may share a face. A point just inside one
;     of a coincident pair is equally near a triangle that calls it outside.
;     So the floor's top sits `seat_mm` *below* the datum and everything that
;     stands on it bases at z = 0: a hairline slot no 25 mm cell can see.

; ---- the room ---------------------------------------------------------------
[defparam room_x_mm 16000.0]    ; inner length, x
[defparam room_y_mm 9000.0]     ; inner width, y
[defparam wall_h_mm 4500.0]     ; eaves
[defparam wall_t_mm 200.0]
[defparam skirt_h_mm 1000.0]    ; the bottom metre of wall that collides
[defparam ridge_mm 5500.0]
[defparam slab_t_mm 200.0]
[defparam seat_mm 1.0]          ; the floor's top, below the datum (see above)
[defparam door_w_mm 3000.0]
[defparam door_h_mm 3000.0]

; ---- the half pipe (the mini ramp of levels/skatepark.loon) ------------------
[defparam hp_x_mm -5000.0]      ; middle of its flat
[defparam tr_r_mm 1200.0]
[defparam lip_mm 600.0]
[defparam width_mm 3000.0]
[defparam flat_mm 3000.0]
[defparam deck_mm 400.0]
[defparam coping_r_mm 30.0]
[defparam hp_slab_mm 40.0]

; ---- the mezzanine ----------------------------------------------------------
[defparam mez_x_mm 3000.0]      ; depth from the −x wall
[defparam mez_y_mm 3000.0]
[defparam mez_z_mm 2600.0]      ; floor top
[defparam mez_t_mm 200.0]
[defparam mez_rail_mm 900.0]    ; guard rail above its floor
[defparam mez_rod_r_mm 30.0]

; ---- the +x quarter pipes, either side of the door --------------------------
[defparam qp_x_mm 6000.0]       ; where their flat ends and the transition starts
[defparam qp_w_mm 2500.0]
[defparam qp_gap_mm 100.0]      ; clear of the door opening

; ---- the platform on the +y wall, with a quarter pipe up to it ---------------
[defparam plat_x0_mm 2000.0]
[defparam plat_x1_mm 5000.0]
[defparam plat_y0_mm 2000.0]    ; its −y face, where the quarter pipe meets it
[defparam plat_h_mm 800.0]
[defparam plat_qp_r_mm 1200.0]
[defparam top_qp_r_mm 600.0]    ; the small one on the deck, against the wall
[defparam top_qp_lip_mm 300.0]

; ---- the rail ---------------------------------------------------------------
[defparam rail_x_mm 3500.0]     ; the bend
[defparam rail_y_mm 0.0]
[defparam rail_z_mm 300.0]      ; its axis
[defparam rail_r_mm 25.0]       ; Ø 50 mm
[defparam rail_half_mm 1000.0]  ; each half, so 2 m of rail
[defparam rail_bend_deg 7.5]    ; half of the 15° bend, each way

; ---- the kickers ------------------------------------------------------------
[defparam kick_run_mm 900.0]    ; the wedge's footprint
[defparam kick_rise_mm 300.0]   ; its lip
[defparam kick_w_mm 1200.0]
[defparam kick_gap_mm 1500.0]   ; lip to lip; the K1 spawns in the middle of it
[defparam kick_t_mm 400.0]      ; the box's thickness before it is sunk
[defparam kick_deg 18.4349]     ; atan(rise/run) — loon has sqrt, not atan

; ---- the ledge and the box piles --------------------------------------------
[defparam ledge_l_mm 3000.0]
[defparam ledge_d_mm 400.0]
[defparam ledge_h_mm 350.0]
[defparam ledge_x_mm 0.0]
[defparam box_mm 500.0]

; ---- the roof ---------------------------------------------------------------
[defparam roof_t_mm 100.0]
[defparam roof_over_mm 100.0]   ; overhang past the walls, each end
[defparam roof_deg 12.0125]     ; atan(rise/run), again
[defparam sky_half_mm 750.0]    ; the skylight strip is 1.5 m wide
[defparam sky_t_mm 30.0]
[defparam truss_r_mm 60.0]
[defparam cler_sill_mm 3200.0]
[defparam cler_h_mm 1000.0]
[defparam cler_w_mm 1600.0]
[defparam cler_pitch_mm 2500.0]
[defparam lamp_r_mm 250.0]
[defparam lamp_h_mm 120.0]
[defparam lamp_z_mm 4180.0]

; ---- the bake ---------------------------------------------------------------
; 20 mm cells over 17 × 10 × 4.4 m is 372 MB of f32; 25 mm is 191 MB, and the
; K1's feet and a 27 mm wheel both still find the transition.
[defparam sdf_cell_mm 25.0]
[defparam sdf_pad_mm 300.0]

; ---- the check --------------------------------------------------------------
; the same wheel as the mini ramp, released on the half pipe's +x transition:
; check_x/y/z name that transition's flat end, so the roll runs on the piece
; the level chose rather than on a hard-wired x = flat/2.
[defparam check_x_mm -3500.0]
[defparam check_y_mm 0.0]
[defparam check_z_mm 40.0]   ; the half pipe stands on its own slab
[defparam wheel_r_mm 27.0]
[defparam wheel_g 60.0]
[defparam drop_mm 450.0]
[defparam friction 0.8]
[defparam t_end 4.0]
[defparam dt_ms 1.0]

; ---- the K1 -----------------------------------------------------------------
[defparam spawn_x_mm 0.0]       ; the middle of the kickers' gap
[defparam spawn_y_mm 0.0]
[defparam spawn_yaw_deg 0.0]    ; +x, toward the rail
[defparam shove_at 1.0]
[defparam shove_ns 8.0]

; ---- helpers ----------------------------------------------------------------
[let box-c [fn [x y z] [translate [/ x -2.0] [/ y -2.0] [/ z -2.0] [cube x y z]]]]
[let rod-y [fn [r l] [translate 0.0 [/ l 2.0] 0.0 [rotate 90.0 0.0 0.0 [cylinder r l]]]]]
[let rod-x [fn [r l] [translate [/ l -2.0] 0.0 0.0 [rotate 0.0 90.0 0.0 [cylinder r l]]]]]
[let rod-z [fn [r l] [translate 0.0 0.0 [/ l -2.0] [cylinder r l]]]]
[let box-at [fn [x0 x1 y0 y1 z0 z1]
  [translate [/ [+ x0 x1] 2.0] [/ [+ y0 y1] 2.0] [/ [+ z0 z1] 2.0]
    [box-c [- x1 x0] [- y1 y0] [- z1 z0]]]]]
; the x a transition of radius r reaches by the time it is lip high
[let tr-run [fn [r lip] [* r [sqrt [- 1.0 [* [- 1.0 [/ lip r]] [- 1.0 [/ lip r]]]]]]]]

[let half-x [/ room_x_mm 2.0]]
[let half-y [/ room_y_mm 2.0]]
[let out-x [+ half-x wall_t_mm]]
[let out-y [+ half-y wall_t_mm]]
[let in-x [- half-x seat_mm]]   ; where a collision root may reach a wall
[let in-y [- half-y seat_mm]]
[let big 2000.0]        ; cutting boxes stay near the thing they cut:
                        ; vcad meshes a 40 m tool as if it mattered

; a quarter pipe: a block from the flat end at x0 to its lip, minus the
; cylinder whose axis runs along y one radius above that flat end. `s` is the
; direction it rises in, ±1 along x; `run` is [tr-run r lip].
[let qp-x [fn [s x0 z0 yc w r lip run]
  [difference
    [translate x0 yc [+ z0 r] [rod-y r [* 1.4 w]]]
    [box-at [- x0 [* [- 1.0 s] [/ run 2.0]]] [+ x0 [* [+ 1.0 s] [/ run 2.0]]]
            [- yc [/ w 2.0]] [+ yc [/ w 2.0]] z0 [+ z0 lip]]]]]

; the same thing rising along y instead, `s` = ±1
[let qp-y [fn [s y0 z0 xc w r lip run]
  [difference
    [translate xc y0 [+ z0 r] [rod-x r [* 1.4 w]]]
    [box-at [- xc [/ w 2.0]] [+ xc [/ w 2.0]]
            [- y0 [* [- 1.0 s] [/ run 2.0]]] [+ y0 [* [+ 1.0 s] [/ run 2.0]]]
            z0 [+ z0 lip]]]]]

; ---- the floor --------------------------------------------------------------
; its top is seat_mm below the datum; everything else bases at z = 0.
[let floor [box-at [- 0.0 out-x] out-x [- 0.0 out-y] out-y
                   [- [- 0.0 seat_mm] slab_t_mm] [- 0.0 seat_mm]]]
[root floor "concrete"]

; ---- the half pipe ----------------------------------------------------------
[let hp-run [tr-run tr_r_mm lip_mm]]
[let hp-half [/ flat_mm 2.0]]
[let hp-side [fn [s]
  [union
    [union
      [qp-x s [+ hp_x_mm [* s hp-half]] 0.0 0.0 width_mm tr_r_mm lip_mm hp-run]
      [box-at [+ hp_x_mm [* s [+ hp-half hp-run]]] [+ hp_x_mm [* s [+ hp-half hp-run deck_mm]]]
              [/ width_mm -2.0] [/ width_mm 2.0] 0.0 lip_mm]]
    [translate [+ hp_x_mm [* s [+ hp-half hp-run]]] 0.0 lip_mm [rod-y coping_r_mm width_mm]]]]]
[let hp-span [+ hp-half hp-run deck_mm]]
[let halfpipe
  [union
    [union
      [box-at [- hp_x_mm hp-span] [+ hp_x_mm hp-span] [/ width_mm -2.0] [/ width_mm 2.0]
              0.0 hp_slab_mm]
      [translate 0.0 0.0 hp_slab_mm [hp-side 1.0]]]
    [translate 0.0 0.0 hp_slab_mm [hp-side -1.0]]]]
[root halfpipe "plywood"]

; ---- the mezzanine ----------------------------------------------------------
; the secret room over the half pipe, hung off the −x wall — a post to the
; floor would land in the middle of the ramp's flat.
[let mez-x1 [+ [- 0.0 in-x] mez_x_mm]]
[let mez-rail-x [- mez-x1 [* 2.0 mez_rod_r_mm]]]
[let mezzanine
  [union
    [union
      [union
        [box-at [- 0.0 in-x] mez-x1 [/ mez_y_mm -2.0] [/ mez_y_mm 2.0]
                [- mez_z_mm mez_t_mm] mez_z_mm]
        [translate mez-rail-x [- [/ mez_y_mm 2.0] mez_rod_r_mm] [+ mez_z_mm [/ mez_rail_mm 2.0]]
          [rod-z mez_rod_r_mm mez_rail_mm]]]
      [translate mez-rail-x [- mez_rod_r_mm [/ mez_y_mm 2.0]] [+ mez_z_mm [/ mez_rail_mm 2.0]]
        [rod-z mez_rod_r_mm mez_rail_mm]]]
    [translate mez-rail-x 0.0 [+ mez_z_mm mez_rail_mm] [rod-y mez_rod_r_mm mez_y_mm]]]]
[root mezzanine "plywood"]

; ---- the +x quarter pipes ---------------------------------------------------
[let qp-yc [+ [/ door_w_mm 2.0] qp_gap_mm [/ qp_w_mm 2.0]]]
[let qp-lip-x [+ qp_x_mm hp-run]]
[let qp [fn [yc]
  [union
    [union
      [qp-x 1.0 qp_x_mm 0.0 yc qp_w_mm tr_r_mm lip_mm hp-run]
      [box-at qp-lip-x in-x [- yc [/ qp_w_mm 2.0]] [+ yc [/ qp_w_mm 2.0]] 0.0 lip_mm]]
    [translate qp-lip-x yc lip_mm [rod-y coping_r_mm qp_w_mm]]]]]
[let qp_left [qp qp-yc]]
[root qp_left "masonite"]
[let qp_right [qp [- 0.0 qp-yc]]]
[root qp_right "masonite"]

; ---- the platform -----------------------------------------------------------
[let plat-w [- plat_x1_mm plat_x0_mm]]
[let plat-xc [/ [+ plat_x0_mm plat_x1_mm] 2.0]]
[let plat-run [tr-run plat_qp_r_mm plat_h_mm]]
[let top-run [tr-run top_qp_r_mm top_qp_lip_mm]]
[let platform
  [union
    [union
      [box-at plat_x0_mm plat_x1_mm plat_y0_mm in-y 0.0 plat_h_mm]
      [qp-y 1.0 [- plat_y0_mm plat-run] 0.0 plat-xc plat-w plat_qp_r_mm plat_h_mm plat-run]]
    [qp-y 1.0 [- in-y top-run] plat_h_mm plat-xc plat-w top_qp_r_mm top_qp_lip_mm top-run]]]
[root platform "masonite"]

; ---- the rail ---------------------------------------------------------------
; two 1 m halves meeting at a 15° bend, on three posts.
[let rail-leg [fn [s]
  [translate rail_x_mm rail_y_mm rail_z_mm
    [rotate 0.0 0.0 [* s rail_bend_deg]
      [translate [* s [/ rail_half_mm 2.0]] 0.0 0.0 [rod-x rail_r_mm rail_half_mm]]]]]]
[let rail-post [fn [s]
  [translate [+ rail_x_mm [* s [* rail_half_mm 0.98]]] rail_y_mm [/ rail_z_mm 2.0]
    [rod-z rail_r_mm rail_z_mm]]]]
[let rail
  [union
    [union
      [union [rail-leg 1.0] [rail-leg -1.0]]
      [translate rail_x_mm rail_y_mm [/ rail_z_mm 2.0] [rod-z rail_r_mm rail_z_mm]]]
    [union [rail-post 1.0] [rail-post -1.0]]]]
[root rail "steel"]

; ---- the kickers ------------------------------------------------------------
; a box rotated about y and sunk into the slab: the cut is what makes the
; wedge, and it leaves the lip a clean vertical face.
[let kick-box-l [sqrt [+ [* kick_run_mm kick_run_mm] [* kick_rise_mm kick_rise_mm]]]]
[let kick-wedge
  [translate [- 0.0 kick_run_mm] 0.0 0.0
    [difference
      [translate 0.0 0.0 [/ big -2.0] [box-c [* 3.0 kick_run_mm] [* 2.0 kick_w_mm] big]]
      [rotate 0.0 [- 0.0 kick_deg] 0.0
        [translate [/ kick-box-l 2.0] 0.0 [/ kick_t_mm -2.0]
          [box-c kick-box-l kick_w_mm kick_t_mm]]]]]]
[let kickers
  [union
    [translate [/ kick_gap_mm -2.0] 0.0 0.0 kick-wedge]
    [translate [/ kick_gap_mm 2.0] 0.0 0.0 [rotate 0.0 0.0 180.0 kick-wedge]]]]
[root kickers "plywood"]

; ---- the ledge --------------------------------------------------------------
[let ledge-y1 [- 0.0 [- in-y ledge_d_mm]]]
[let ledge
  [union
    [box-at [- ledge_x_mm [/ ledge_l_mm 2.0]] [+ ledge_x_mm [/ ledge_l_mm 2.0]]
            [- 0.0 in-y] ledge-y1 0.0 ledge_h_mm]
    [translate ledge_x_mm ledge-y1 ledge_h_mm [rod-x coping_r_mm ledge_l_mm]]]]
[root ledge "concrete"]

; ---- the box piles ----------------------------------------------------------
; stacked cubes overlap by a millimetre so each pile unions into one shell.
[let pile2 [fn [x y]
  [union
    [translate x y [/ box_mm 2.0] [box-c box_mm box_mm box_mm]]
    [translate x y [- [* 1.5 box_mm] 1.0] [box-c box_mm box_mm box_mm]]]]]
[let pile3 [fn [x y]
  [union [pile2 x y]
    [translate x y [- [* 2.5 box_mm] 2.0] [box-c box_mm box_mm box_mm]]]]]
[let boxes
  [union
    [union
      [union [pile3 -6500.0 3700.0] [pile2 -2500.0 3900.0]]
      [union [pile2 600.0 3900.0] [pile2 -6500.0 -3900.0]]]
    [pile3 5000.0 -3900.0]]]
[root boxes "cardboard"]

; ---- the walls --------------------------------------------------------------
; a ring: the outer box minus the inner one, cut in two at the skirt's top.
[let ring [fn [z0 z1]
  [difference
    [box-at [- 0.0 half-x] half-x [- 0.0 half-y] half-y [- z0 500.0] [+ z1 500.0]]
    [box-at [- 0.0 out-x] out-x [- 0.0 out-y] out-y z0 z1]]]]
[let doorway [box-at [- half-x 1.0] [+ out-x 1.0] [/ door_w_mm -2.0] [/ door_w_mm 2.0]
                     -100.0 door_h_mm]]
[let wall_skirt [difference doorway [ring 0.0 skirt_h_mm]]]
[root wall_skirt "brick"]

; the clerestory openings, six of them, high on the +y wall
[let cler-z1 [+ cler_sill_mm cler_h_mm]]
[let window [fn [x]
  [box-at [- x [/ cler_w_mm 2.0]] [+ x [/ cler_w_mm 2.0]]
          [- half-y 1.0] [+ out-y 1.0] cler_sill_mm cler-z1]]]
[let windows
  [union
    [union
      [union [window [* -2.5 cler_pitch_mm]] [window [* -1.5 cler_pitch_mm]]]
      [union [window [* -0.5 cler_pitch_mm]] [window [* 0.5 cler_pitch_mm]]]]
    [union [window [* 1.5 cler_pitch_mm]] [window [* 2.5 cler_pitch_mm]]]]]
[let walls_upper [difference windows [difference doorway [ring skirt_h_mm wall_h_mm]]]]
[root walls_upper "no-collide brick"]

[let pane [fn [x]
  [box-at [- x [/ cler_w_mm 2.0]] [+ x [/ cler_w_mm 2.0]]
          [- half-y [/ sky_t_mm 2.0]] [+ half-y [/ sky_t_mm 2.0]] cler_sill_mm cler-z1]]]
[let clerestory
  [union
    [union
      [union [pane [* -2.5 cler_pitch_mm]] [pane [* -1.5 cler_pitch_mm]]]
      [union [pane [* -0.5 cler_pitch_mm]] [pane [* 0.5 cler_pitch_mm]]]]
    [union [pane [* 1.5 cler_pitch_mm]] [pane [* 2.5 cler_pitch_mm]]]]]
[root clerestory "no-collide glass"]

[let door_frame
  [difference
    [box-at [- half-x 2.0] [+ out-x 2.0] [/ door_w_mm -2.0] [/ door_w_mm 2.0] -300.0 door_h_mm]
    [box-at [- half-x 1.0] [+ out-x 1.0]
            [- 0.0 [+ [/ door_w_mm 2.0] 150.0]] [+ [/ door_w_mm 2.0] 150.0]
            -200.0 [+ door_h_mm 150.0]]]]
[root door_frame "no-collide steel"]

; ---- the roof ---------------------------------------------------------------
[let roof-rise [- ridge_mm wall_h_mm]]
[let roof-hyp [sqrt [+ [* out-y out-y] [* roof-rise roof-rise]]]]
[let roof-cos [/ out-y roof-hyp]]
[let roof-slope [/ roof-rise out-y]]        ; dz per unit of plan y
[let roof-len [+ [* 2.0 out-x] [* 2.0 roof_over_mm]]]
[let panel-yc [/ [+ sky_half_mm out-y] 2.0]]
[let panel-l [/ [- out-y sky_half_mm] roof-cos]]
[let slab-at [fn [s yc l t]
  [translate 0.0 [* s yc] [- ridge_mm [* yc roof-slope]]
    [rotate [* [- 0.0 s] roof_deg] 0.0 0.0 [box-c roof-len l t]]]]]
[let roof [union [slab-at 1.0 panel-yc panel-l roof_t_mm]
                 [slab-at -1.0 panel-yc panel-l roof_t_mm]]]
[root roof "no-collide galvanized"]

[let sky-yc [/ sky_half_mm 2.0]]
[let sky-l [/ sky_half_mm roof-cos]]
[let skylight [union [slab-at 1.0 sky-yc sky-l sky_t_mm]
                     [slab-at -1.0 sky-yc sky-l sky_t_mm]]]
[root skylight "no-collide glass"]

; ---- the trusses ------------------------------------------------------------
; bar joists, not tubes: a truss is twenty members, and unioning twenty
; cylinders costs the B-rep kernel far more than unioning twenty boxes.
[let chord [fn [s]
  [translate 0.0 [* s [/ out-y 2.0]] [/ [+ wall_h_mm ridge_mm] 2.0]
    [rotate [* [- 0.0 s] roof_deg] 0.0 0.0
      [box-c [* 2.0 truss_r_mm] roof-hyp [* 2.0 truss_r_mm]]]]]]
[let truss [fn [x]
  [translate x 0.0 0.0
    [union
      [union
        [translate 0.0 0.0 wall_h_mm [box-c [* 2.0 truss_r_mm] [* 2.0 out-y] [* 2.0 truss_r_mm]]]
        [translate 0.0 0.0 [/ [+ wall_h_mm ridge_mm] 2.0]
          [box-c [* 2.0 truss_r_mm] [* 2.0 truss_r_mm] roof-rise]]]
      [union [chord 1.0] [chord -1.0]]]]]]
[let trusses
  [union
    [union [union [truss -6000.0] [truss -3000.0]] [union [truss 0.0] [truss 3000.0]]]
    [truss 6000.0]]]
[root trusses "no-collide steel"]

; ---- the lamps --------------------------------------------------------------
[let lamp [fn [x]
  [union
    [translate x 0.0 [+ lamp_z_mm [/ lamp_h_mm 2.0]] [rod-z lamp_r_mm lamp_h_mm]]
    [translate x 0.0 [/ [+ [+ lamp_z_mm lamp_h_mm] wall_h_mm] 2.0]
      [rod-z 20.0 [- wall_h_mm [+ lamp_z_mm lamp_h_mm]]]]]]]
[let lamps
  [union
    [union [union [lamp -6000.0] [lamp -3600.0]] [union [lamp -1200.0] [lamp 1200.0]]]
    [union [lamp 3600.0] [lamp 6000.0]]]]
[root lamps "no-collide lamp"]
